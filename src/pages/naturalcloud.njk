---
layout: base.njk
title: "NaturalCloud™"
summary: "NaturalCloud™ securely stores authentication records and NaturalDetect™ test results, giving companies a centralized view of verification activity."
permalink: /naturalcloud/
---

<section class="challenge" style="padding-top:9rem">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label anim anim-up">{{ naturalcloud.label }}</span>
        <h2 class="section-title anim anim-up delay-1">{{ naturalcloud.title }}</h2>
        <p class="section-subtitle anim anim-up delay-2">{{ naturalcloud.hero }}</p>
        <p class="challenge-lead anim anim-up delay-3" style="margin-top:1.5rem">{{ naturalcloud.intro }}</p>
        <p class="challenge-sub anim anim-up delay-3">{{ naturalcloud.features_title }}</p>
        <ul class="challenge-list anim anim-up delay-4">
          {% for item in naturalcloud.features %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem">
          <a href="{{ naturalcloud.cta_primary_url }}" class="btn btn-primary anim anim-up delay-4" style="cursor:pointer">{{ naturalcloud.cta_primary }} &#8594;</a>
        </div>
      </div>
      <div class="solution-mark anim anim-left delay-2">
        <img src="{{ naturalcloud.hero_logo }}" alt="{{ naturalcloud.hero_logo_alt }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner anim anim-up">
      <h2>{{ naturalcloud.cta_secondary }}</h2>
      <div class="finalcta-actions">
        <a href="{{ naturalcloud.cta_primary_url }}" class="btn btn-white" style="cursor:pointer">{{ naturalcloud.cta_primary }} &#8594;</a>
      </div>
    </div>
  </div>
</section>
