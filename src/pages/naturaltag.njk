---
layout: base.njk
title: "NaturalTag™"
summary: "NaturalTag™ is a food-grade, in-product authentication tag made from inactivated probiotics, incorporated directly into products during manufacturing."
permalink: /naturaltag/
---

<section class="challenge" style="padding-top:9rem">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label anim anim-up">{{ naturaltag.label }}</span>
        <h2 class="section-title anim anim-up delay-1">{{ naturaltag.title }}</h2>
        <p class="section-subtitle anim anim-up delay-2">{{ naturaltag.hero }}</p>
        <p class="challenge-lead anim anim-up delay-3" style="margin-top:1.5rem">{{ naturaltag.intro }}</p>
        <a href="{{ naturaltag.cta_url }}" class="btn btn-primary anim anim-up delay-4" style="cursor:pointer">{{ naturaltag.cta_text }} &#8594;</a>
      </div>
      <div class="solution-mark anim anim-left delay-2">
        <img src="{{ naturaltag.hero_logo }}" alt="{{ naturaltag.hero_logo_alt }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

<section class="valueprop">
  <div class="container">
    <div class="vp-grid about-grid-2">
      <article class="vp-card anim anim-up">
        <h3>{{ naturaltag.why_title }}</h3>
        <ul class="sol-list" style="grid-template-columns:1fr;margin-top:0">
          {% for item in naturaltag.why_items %}<li>{{ item }}</li>{% endfor %}
        </ul>
      </article>
      <article class="vp-card anim anim-up delay-1">
        <h3>{{ naturaltag.features_title }}</h3>
        <ul class="sol-list" style="grid-template-columns:1fr;margin-top:0">
          {% for item in naturaltag.features %}<li>{{ item }}</li>{% endfor %}
        </ul>
      </article>
    </div>
  </div>
</section>

<section class="howitworks">
  <div class="container">
    <div class="how-head">
      <span class="section-label anim anim-up">{{ naturaltag.matrices_title }}</span>
      <h2 class="section-title anim anim-up delay-1">{{ naturaltag.video_title }}</h2>
      <p class="anim anim-up delay-2" style="color:rgba(255,255,255,.65);font-size:.98rem;line-height:1.8">{{ naturaltag.video_description }}</p>
    </div>
    <div class="how-grid" style="grid-template-columns:repeat(3,1fr)">
      {% for m in naturaltag.matrices %}
      <div class="how-step anim anim-up delay-{{ loop.index }}">
        <h3>{{ m.group }}</h3>
        <p>{{ m.items }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="anim anim-up delay-3" style="margin-top:3.5rem;border-radius:20px;overflow:hidden;box-shadow:var(--shadow-lg)">
      <video src="{{ naturaltag.video_src }}" muted loop playsinline autoplay style="width:100%;display:block"></video>
    </div>
  </div>
</section>

<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner anim anim-up">
      <h2>Your product's identity starts at the source.</h2>
      <div class="finalcta-actions">
        <a href="{{ naturaltag.cta_url }}" class="btn btn-white" style="cursor:pointer">{{ naturaltag.cta_text }} &#8594;</a>
      </div>
    </div>
  </div>
</section>
