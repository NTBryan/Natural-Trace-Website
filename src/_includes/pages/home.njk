<section class="hero">
  <div class="hero-bg" id="heroBg" style="background-image:url('{{ home.hero_bg_image }}')"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-copy">
      <h1>
        <span class="hero-line"><span class="hero-line-inner">{{ home.hero_title_line1 }}</span></span>
        <span class="hero-line"><span class="hero-line-inner"><em>{{ home.hero_title_line2 }}</em></span></span>
      </h1>
      {# Kirsty's positioning line, verbatim, now opening the lead paragraph.
         It used to sit above the H1 as an eyebrow label. #}
      <p class="hero-lead"><strong>{{ home.hero_slogan }}.</strong> {{ home.hero_desc }}</p>
      <p class="hero-claims">{% for c in home.hero_claims %}{{ c }}{% if loop.revindex0 == 1 %} and {% elif not loop.last %}, {% endif %}{% endfor %}{% if home.hero_claims_coda %}, <span>{{ home.hero_claims_coda }}</span>{% endif %}.</p>
      <div class="hero-actions">
        <a href="{{ home.hero_cta_url }}" class="btn btn-primary" style="cursor:pointer">{{ home.hero_cta }} &#8594;</a>
        <a href="{{ home.hero_cta_secondary_url }}" class="btn btn-outline" style="cursor:pointer">{{ home.hero_cta_secondary }}</a>
      </div>
    </div>
    <div class="hero-visual"><img src="{{ home.hero_image }}" alt="{{ home.hero_image_alt }}" loading="eager"></div>
  </div>
</section>

<!-- Section 2: The Challenge -->
<section class="challenge" id="challenge">
  <div class="container">
    <div class="challenge-grid">
      <div class="challenge-text">
        <span class="section-label">{{ home.challenge_label }}</span>
        <h2 class="section-title">{{ home.challenge_title }}</h2>
        <p class="challenge-lead">{{ home.challenge_lead }}</p>
        <p class="challenge-sub">{{ home.challenge_list_label }}</p>
        <ul class="challenge-list">
          {% for item in home.challenge_list %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <p class="challenge-close">{{ home.challenge_close }}</p>
      </div>
      <div class="challenge-media">
        <img src="{{ home.challenge_image }}" alt="{{ home.challenge_image_alt }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- Section 3: Value Proposition -->
<section class="valueprop" id="value">
  <div class="container">
    <div class="vp-head">
      <span class="section-label">{{ home.vp_label }}</span>
      <h2 class="section-title">{{ home.vp_title }}</h2>
      <p class="section-subtitle">{{ home.vp_subtitle }}</p>
    </div>
    <div class="vp-grid">
      {% for card in home.vp_cards %}
      <article class="vp-card delay-{{ loop.index }}">
        <span class="vp-num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
        <h3>{{ card.title }}</h3>
        <div class="vp-block">
          <span class="vp-block-label">{{ home.vp_problem_label }}</span>
          <p>{{ card.problem }}</p>
        </div>
        <div class="vp-block is-value">
          <span class="vp-block-label">{{ home.vp_value_label }}</span>
          <p>{{ card.value }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Section 4: How It Works -->
<section class="howitworks" id="how-it-works">
  <div class="container">
    <div class="how-head">
      <span class="section-label">{{ home.how_label }}</span>
      <h2 class="section-title">{{ home.how_title }}</h2>
    </div>
    <div class="how-grid">
      {% for step in home.how_steps %}
      <div class="how-step delay-{{ loop.index }}">
        <div class="how-step-num">{{ step.num }}</div>
        <h3>{{ step.title }}</h3>
        <p>{{ step.description }}</p>
      </div>
      {% endfor %}
    </div>
    <ul class="how-facts">
      {% for feature in home.how_features %}<li>{{ feature }}</li>{% endfor %}
    </ul>
  </div>
</section>

<!-- Section 5: Industry Tiles -->
<section class="home-industries" id="industries">
  <div class="container">
    <div class="industries-header">
      <span class="section-label">{{ home.industries_label }}</span>
      <h2 class="section-title">{{ home.industries_title }}</h2>
    </div>
    <div class="industries-grid">
      {% for industry in home.industry_tiles %}
      <a class="industry-card delay-{{ loop.index }}" href="{{ industry.url }}">
        <img src="{{ industry.image }}" alt="{{ industry.image_alt }}" loading="lazy">
        <div class="industry-card-overlay"><h3>{{ industry.name }}</h3><p>{{ industry.description }}</p></div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Partners Trust Bar -->
<div class="trust-bar">
  <div class="container">
    <div class="trust-bar-inner">
      <span class="trust-label">{{ home.trust_label }}</span>
      <div class="trust-logos">
        {% for logo in home.trust_logos %}
        <a class="trust-logo" href="{{ logo.url }}" target="_blank" rel="noopener"><img src="{{ logo.image }}" alt="{{ logo.alt }}"></a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<!-- Final Call to Action -->
<section class="finalcta">
  <div class="container">
    <div class="finalcta-inner">
      <h2>{{ home.final_cta_title }}</h2>
      <p>{{ home.final_cta_text }}</p>
      <div class="finalcta-actions">
        <a href="{{ home.final_cta_primary_url }}" class="btn btn-white" style="cursor:pointer">{{ home.final_cta_primary }} &#8594;</a>
        <a href="{{ home.final_cta_secondary_url }}" class="btn btn-ghost" style="cursor:pointer">{{ home.final_cta_secondary }}</a>
      </div>
    </div>
  </div>
</section>

<!-- Compatibility Quiz -->
<section class="compat-section">
  <div class="container">
    <div style="text-align:center;margin-bottom:2rem">
      <span class="section-label">{{ home.compat_label }}</span>
      <h2 class="section-title" style="color:#fff">{{ home.compat_title }}</h2>
      <p style="color:rgba(255,255,255,.6);max-width:600px;margin:0 auto">{{ home.compat_subtitle }}</p>
    </div>
    <div class="compat-quiz" id="compatQuiz">
      <!-- Progress bar -->
      <div class="compat-progress" id="compatProgress" style="display:none">
        <span class="compat-step-label" id="compatStepLabel">Step 1 of 3</span>
        <div class="compat-progress-bar"><div class="compat-progress-fill" id="compatProgressFill" style="width:33%"></div></div>
      </div>

      <!-- Welcome Screen -->
      <div class="compat-screen active" id="compatWelcome">
        <div class="compat-welcome">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" style="margin-bottom:1rem"><circle cx="32" cy="32" r="30" stroke="var(--sage)" stroke-width="2.5" fill="rgba(107,114,73,.08)"/><path d="M22 32l6 6 14-14" stroke="var(--sage)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
          <h3>{{ home.compat_welcome_title }}</h3>
          <p>{{ home.compat_welcome_desc }}</p>
          <button class="compat-cta" onclick="compatStart()">{{ home.compat_welcome_cta }}</button>
        </div>
      </div>

      <!-- Step 1: Product Category -->
      <div class="compat-screen" id="compatStep1">
        <p class="compat-q">{{ home.compat_step1_question }}</p>
        <div class="compat-grid" id="compatCategories"></div>
        <div class="compat-next-wrap" id="compatNext1">
          <button class="compat-next" onclick="compatGoStep(2)">{{ home.compat_btn_next }}</button>
        </div>
      </div>

      <!-- Step 2: Formulation -->
      <div class="compat-screen" id="compatStep2">
        <p class="compat-q">{{ home.compat_step2_question }}</p>
        <p style="color:var(--muted);font-size:.82rem;margin-top:-.75rem;margin-bottom:1rem">{{ home.compat_step2_hint }}</p>
        <div class="compat-grid compat-grid-3" id="compatFormulations"></div>
        <div class="compat-next-wrap" id="compatNext2">
          <button class="compat-back" onclick="compatGoStep(1)">{{ home.compat_btn_back }}</button>
          <button class="compat-next" onclick="compatGoStep(3)">{{ home.compat_btn_next }}</button>
        </div>
      </div>

      <!-- Step 3: Processing Conditions -->
      <div class="compat-screen" id="compatStep3">
        <p class="compat-q">{{ home.compat_step3_question }}</p>
        <div class="compat-conditions">
          <div class="compat-condition-group">
            <h4>{{ home.compat_step3_temp_label }}</h4>
            <div class="compat-condition-options" id="compatTempOptions"></div>
          </div>
          <div class="compat-condition-group">
            <h4>{{ home.compat_step3_ph_label }}</h4>
            <div class="compat-condition-options" id="compatPhOptions"></div>
          </div>
        </div>
        <div class="compat-next-wrap" id="compatNext3">
          <button class="compat-back" onclick="compatGoStep(2)">{{ home.compat_btn_back }}</button>
          <button class="compat-next" onclick="compatShowConfirm()">{{ home.compat_btn_next }}</button>
        </div>
      </div>

      <!-- Confirmation Screen -->
      <div class="compat-screen" id="compatConfirm">
        <div class="compat-welcome">
          <h3>{{ home.compat_confirm_title }}</h3>
          <p>{{ home.compat_confirm_desc }}</p>
          <a class="compat-cta" href="{{ home.compat_result_cta_url }}" style="text-decoration:none;display:inline-block">{{ home.compat_result_cta }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
